# Documenta as variáveis. As cópias reais ficam em cada app:
#   apps/api/.env  (cp apps/api/.env.example apps/api/.env)
#   apps/web/.env  (cp apps/web/.env.example apps/web/.env)

# ── apps/api ──
DATABASE_URL=postgresql://wn:wn@localhost:5433/wn
PORT=5001
NODE_ENV=development
JWT_ACCESS_SECRET=dev-access-secret-troque-em-producao-0123456789abcdef
JWT_ACCESS_TTL=1h
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5000
BCRYPT_ROUNDS=12
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=1000
SCHEDULER_BATCH=50
WORLD_SEED=vharos-1
WORLD_GAME_SPEED=1
WORLD_ECONOMY_SPEED=1
LOG_LEVEL=info

# ── apps/web ──
VITE_API_URL=http://localhost:5001
VITE_WS_URL=http://localhost:5001
