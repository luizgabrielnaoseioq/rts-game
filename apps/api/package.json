{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "swc src -d dist --strip-leading-paths && concurrently -k -n swc,node \"swc src -d dist --strip-leading-paths -w\" \"node --enable-source-maps --env-file-if-exists=.env --watch-path=dist --watch-path=../../packages/shared/dist dist/main.js\"",
    "build": "prisma generate && swc src -d dist --strip-leading-paths",
    "start:prod": "node --enable-source-maps dist/main.js",
    "db:seed": "prisma db seed",
    "test": "vitest run --passWithNoTests"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/platform-socket.io": "^12.6.0",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/websockets": "^12.6.0",
    "@prisma/client": "^6.19.3",
    "@wn/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
